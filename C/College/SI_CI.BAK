//Program to calculate Simple & Compound Interest
#include<stdio.h>
#include<conio.h>
#include<math.h>
int main()
{
int p,n,a;
float r,si,ci;
clrscr();
printf("Enter Principal Amount: ");
scanf("%d",&p);
printf("Enter Rate of Interest: ");
scanf("%f",&r);
printf("Enter Number of Years: ");
scanf("%d",&n);
si = p*n*r/100;
a = p*pow((1+r/100),n);
ci = a-p;
printf("The Simple Interest is s %f",si);
printf("\nThe Compound Interest is s %f",ci);
getch();
return 0;
}